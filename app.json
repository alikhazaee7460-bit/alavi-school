{
  "expo": {
    "owner": "alikhazaei",
    "name": "دبستان دخترانه علوی اسلامی",
    "slug": "alavi-school",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ir.alavi.school"
    },
    "android": {
      "package": "ir.alavi.school"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "اجازه دسترسی به گالری برای آپلود عکس در گالری مدرسه."
        }
      ]
    ],
    "extra": {
      "supportsRTL": true,
      "eas": {
        "projectId": "3fdef87a-1cdf-4fa8-bc2f-637e7a431361"
      }
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}